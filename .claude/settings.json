{
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(bash */skills/codex/scripts/run-codex.sh:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.mcp.json)",
      "Read(.claude/settings.local.json)"
    ],
    "ask": [
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(dist-ssr/**)",
      "Read(coverage/**)",
      "Read(**/*.tsbuildinfo)",
      "Read(bun.lock)",
      "Read(.git/**)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "all@baton": true,
    "ui@baton": true,
    "feature@baton": true,
    "refactor@baton": true,
    "test@baton": true,
    "security@baton": true,
    "review@baton": true,
    "git@baton": true,
    "progress@baton": true,
    "context@baton": true,
    "prefs@baton": true,
    "biome@baton": true,
    "baton@baton": true
  },
  "language": "korean"
}
