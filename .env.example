# Google AI Studio에서 발급: https://aistudio.google.com/apikey
# 이 키는 서버(Vercel 함수 / 개발 서버 미들웨어)에서만 읽는다 —
# VITE_ 접두사가 없으므로 클라이언트 번들에는 들어가지 않는다.
GOOGLE_GENERATIVE_AI_API_KEY=

# 선택. 비워두면 gemini-3.5-flash-lite를 쓴다.
#
# 무료 티어 일일 한도가 모델마다 크게 다르다 — Flash 계열은 하루 20건이라 공개 사이트에는
# 부족하고, Lite 계열은 훨씬 넉넉하다. 지금 이 키로 쓸 수 있는 것(2026-09 확인):
#   gemini-3.5-flash-lite · gemini-3.1-flash-lite · gemini-flash-lite-latest   ← 넉넉
#   gemini-3.5-flash · gemini-3.6-flash · gemini-3.7-flash · gemini-3-flash-preview
# (gemini-2.5-* 계열은 신규 사용자에게 404다)
# 남은 한도는 https://aistudio.google.com/rate-limit 에서 볼 수 있다.
GEMINI_MODEL=
